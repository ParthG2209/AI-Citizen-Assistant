# Copy to `.env` (repo root) and adjust. Never commit `.env`.
# All values below are local-development defaults; no paid service is required.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10

# --- PostgreSQL (docker compose maps it to host port 5433) ---
POSTGRES_USER=aca
POSTGRES_PASSWORD=aca_dev_password
POSTGRES_DB=aca
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://aca:aca_dev_password@localhost:5433/aca
# Seconds before giving up on a PostgreSQL connection (fail fast instead of hanging)
DB_CONNECT_TIMEOUT_S=5
# Optional: test database (defaults to the same server, database `aca_test`)
# TEST_DATABASE_URL=postgresql+psycopg://aca:aca_dev_password@localhost:5433/aca_test

# --- Neo4j Community ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aca_dev_password
NEO4J_DATABASE=neo4j
NEO4J_CONNECT_TIMEOUT=3
# false = always use the deterministic in-memory graph
KG_USE_NEO4J=true

# --- LLM (explanations only; never decides eligibility) ---
OLLAMA_BASE_URL=http://localhost:11434
# 8 GB RAM machines: qwen2.5:3b-instruct; machines with a GPU / 16 GB: qwen2.5:7b-instruct
OLLAMA_MODEL=qwen2.5:3b-instruct
# Optional fallback (free tier). Leave empty to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_TIMEOUT_S=120
GEMINI_TIMEOUT_S=60
# 1 = never call an LLM; answers quote retrieved official passages only
RAG_LLM_DISABLED=0
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DEVICE=cpu
# Minimum cosine similarity for a passage to count as evidence
RAG_MIN_SCORE=0.32

# --- OCR (PaddleOCR, CPU by default) ---
ACA_OCR_LANGS=en,hi
ACA_OCR_DEVICE=cpu
ACA_OCR_MAX_FILE_MB=10
ACA_OCR_MAX_PAGES=5
ACA_OCR_PDF_DPI=200
ACA_OCR_REVIEW_THRESHOLD=0.80
# oneDNN: keep detection off (paddlepaddle 3.3 PP-OCRv5 detector crashes with it on)
ACA_OCR_MKLDNN=1
ACA_OCR_DET_MKLDNN=0
# PADDLE_PDX_CACHE_HOME=~/.paddlex     # model cache (~21 MB)

# --- Paths ---
# RULES_DIR=ai_modules/rule_engine/rules
# DATA_DIR=data
ANALYTICS_OUTPUT_DIR=data/processed/analytics

# --- Analytics (synthetic demo data) ---
ANALYTICS_ENGINE=pandas
SYNTHETIC_SEED=20261118
# Spark (only when ANALYTICS_ENGINE=spark; needs Java 17)
# JAVA_HOME=C:\path\to\jdk-17
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=4
UNDERSERVED_MAX_COVERAGE_PCT=50
UNDERSERVED_MIN_GAP_DISTRICT=500
UNDERSERVED_MIN_GAP_BLOCK=100
UNDERSERVED_MIN_GAP_VILLAGE=20
ANALYTICS_TOP_DOCUMENTS=3

# --- Docker compose backend host port (some Windows hosts reserve 7841-8340) ---
BACKEND_PORT=8000
